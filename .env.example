# MongoDB Atlas connection string (or "memory" for embedded local MongoDB)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/crewoz
MONGODB_DB=crewoz

# Google Gemini API key (https://aistudio.google.com/apikey)
# Supports AIza... (standard) and AQ.... (auth keys)
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_MODEL=gemini-2.5-flash
