# Copy from project root .env.local — ADK reads GOOGLE_API_KEY (not GEMINI_API_KEY)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# MongoDB MCP connection (same Atlas URI as CrewOS)
MDB_MCP_CONNECTION_STRING=mongodb+srv://user:pass@cluster.mongodb.net/crewoz
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/crewoz
